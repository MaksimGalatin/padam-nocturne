{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PADAM Studio",
  "version": "0.2.0",
  "identifier": "com.codeofdigitaleternity.padam.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PADAM · NOCTURNE Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "../icons/padam.ico"
    ]
  }
}
