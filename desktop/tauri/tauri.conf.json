{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PADAM Studio",
  "version": "0.5.1",
  "identifier": "com.codeofdigitaleternity.padam.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PADAM · NOCTURNE Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CODE Eternal LLC",
    "copyright": "Copyright (c) 2026 CODE Eternal LLC",
    "homepage": "https://aifa.works",
    "shortDescription": "PADAM · NOCTURNE Studio — Локальная защищённая память ИИ-агентов",
    "longDescription": "PADAM · NOCTURNE Studio — локальный центр управления защищённой памятью ИИ-агентов в одном SQLite-файле с встроенной средой Python 3.14 (runtime/python.exe) на 127.0.0.1.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime": "runtime"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": [
          "Russian",
          "English",
          "SpanishInternational",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
