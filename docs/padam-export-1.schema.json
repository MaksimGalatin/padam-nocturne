{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MaksimGalatin/padam-nocturne/blob/main/docs/padam-export-1.schema.json",
  "title": "PADAM memory export, format padam-export/1",
  "description": "A person's whole memory as one self-contained JSON document: records with their full version history, sessions, sleep runs and the links between a conclusion and the records it was drawn from. Any program can read it without PADAM; `padam import` restores it. Vectors are not included: they depend on the embedding model and are recomputed on import.",
  "type": "object",
  "required": ["format", "exported_at", "user_id", "counts", "memory", "sessions", "nocturne_runs"],
  "properties": {
    "format": {"const": "padam-export/1"},
    "exported_at": {"type": "string", "description": "ISO 8601 time of the export, UTC"},
    "user_id": {"type": "string"},
    "counts": {
      "type": "object",
      "required": ["memory", "memory_total", "sessions", "nocturne_runs"],
      "properties": {
        "memory": {"type": "integer", "minimum": 0, "description": "records in this document"},
        "memory_total": {"type": "integer", "minimum": 0, "description": "records matching the export filter, before paging"},
        "sessions": {"type": "integer", "minimum": 0},
        "nocturne_runs": {"type": "integer", "minimum": 0},
        "links": {"type": "integer", "minimum": 0}
      }
    },
    "memory": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "started_at"],
        "properties": {
          "id": {"type": "string"},
          "started_at": {"type": "string"},
          "last_active_at": {"type": ["string", "null"]},
          "episode_count": {"type": ["integer", "null"]}
        }
      }
    },
    "nocturne_runs": {"type": "array", "items": {"type": "object", "required": ["id", "started_at"]}},
    "links": {
      "type": "array",
      "description": "Conclusion `dst` was drawn from record `src`. Forgetting `src` with --with-derived also forgets `dst`.",
      "items": {
        "type": "object",
        "required": ["src", "dst"],
        "properties": {"src": {"type": "string"}, "dst": {"type": "string"}, "created_at": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "kind", "content", "status", "created_at", "confidence", "importance"],
      "properties": {
        "id": {"type": "string"},
        "user_id": {"type": "string"},
        "scope": {"type": "string", "description": "Namespace, e.g. 'global' or 'project:code'"},
        "kind": {"enum": ["preference", "identity", "decision", "correction", "fact", "state", "event"]},
        "content": {"type": ["string", "null"], "description": "null after the record was forgotten (revoked)"},
        "status": {"enum": ["active", "superseded", "archived", "revoked", "quarantined", "rejected"]},
        "origin": {"enum": ["user", "agent", "external", null]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "created_at": {"type": "string"},
        "valid_from": {"type": ["string", "null"], "description": "since when the record was true"},
        "valid_to": {"type": ["string", "null"], "description": "until when; null while it is still true"},
        "supersedes": {"type": ["string", "null"], "description": "id of the previous version"},
        "superseded_by": {"type": ["string", "null"], "description": "id of the next version"},
        "content_hash": {"type": ["string", "null"], "description": "SHA-256 of the content, hex; kept after forgetting as a receipt"},
        "quarantine_reason": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]},
        "last_confirmed_at": {"type": ["string", "null"]},
        "refuted_count": {"type": ["integer", "null"]}
      }
    }
  }
}
