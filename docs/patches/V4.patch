+"use client";
+
+import React, { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+
+export default function ClaimAgentPage() {
+  const router = useRouter();
+  const [code, setCode] = useState("");
+  const [pin, setPin] = useState("");
+  const [status, setStatus] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    const sp = new URLSearchParams(window.location.search);
+    const c = sp.get("code") || "";
+    if (c) setCode(c);
+  }, []);
+
+  async function onSubmit(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setStatus(null);
+    try {
+      const res = await fetch("/api/agent-signup/claim", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ claim_code: code.trim(), claim_pin: pin.trim() }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setStatus(data.error || "Claim failed");
+      } else {
+        setStatus("РђРіРµРЅС‚ СѓСЃРїРµС€РЅРѕ РїСЂРёРІСЏР·Р°РЅ Рє РІР°С€РµРјСѓ Р°РєРєР°СѓРЅС‚Сѓ.");
+        setTimeout(() => router.push("/cabinet"), 1000);
+      }
+    } catch (err) {
+      setStatus(String(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <main className="mx-auto max-w-md px-4 py-16 text-slate-100">
+      <h1 className="text-2xl font-semibold mb-2">РџСЂРёРІСЏР·РєР° sandbox-Р°РіРµРЅС‚Р° PADAM</h1>
+      <p className="text-sm text-slate-400 mb-6">
+        Р’РІРµРґРёС‚Рµ РєРѕРґ РїСЂРёРІСЏР·РєРё Рё РѕРґРЅРѕСЂР°Р·РѕРІС‹Р№ 6-Р·РЅР°С‡РЅС‹Р№ PIN, РїРѕРєР°Р·Р°РЅРЅС‹Р№ РїСЂРё Р·Р°РїСѓСЃРєРµ РІР°С€РµРіРѕ Р°РіРµРЅС‚Р°.
+      </p>
+      <form onSubmit={onSubmit} className="space-y-4 rounded-xl border border-slate-700 bg-slate-900/70 p-6">
+        <div>
+          <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1">Claim Code</label>
+          <input
+            type="text"
+            value={code}
+            onChange={(e) => setCode(e.target.value)}
+            required
+            className="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm"
+          />
+        </div>
+        <div>
+          <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1">6-digit PIN</label>
+          <input
+            type="text"
+            inputMode="numeric"
+            pattern="[0-9]{6}"
+            value={pin}
+            onChange={(e) => setPin(e.target.value)}
+            required
+            className="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm"
+          />
+        </div>
+        <button
+          type="submit"
+          disabled={busy}
+          className="w-full rounded-lg bg-sky-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-sky-400 disabled:opacity-50"
+        >
+          {busy ? "РџСЂРѕРІРµСЂСЏРµРјвЂ¦" : "РџСЂРёРІСЏР·Р°С‚СЊ Рє РєР°Р±РёРЅРµС‚Сѓ"}
+        </button>
+        {status && <p className="text-sm text-sky-300">{status}</p>}
+      </form>
+    </main>
+  );
+}
diff --git a/web/src/lib/agent-signup.ts b/web/src/lib/agent-signup.ts
new file mode 100644
index 0000000..f4896ea
--- /dev/null
+++ b/web/src/lib/agent-signup.ts
@@ -0,0 +1,61 @@
+import crypto from 'node:crypto';
+import type { Pool } from '@neondatabase/serverless';
+
+export const SANDBOX_LIMITS = {
+  tier: 'sandbox',
+  maxRecords: 500,
+  maxBytes: 2 * 1024 * 1024,
+  ttlDays: 14,
+  paidOpsDisabled: true,
+} as const;
+
+// DER SPKI-РїСЂРµС„РёРєСЃ РґР»СЏ 32-Р±Р°Р№С‚РЅРѕРіРѕ РѕС‚РєСЂС‹С‚РѕРіРѕ РєР»СЋС‡Р° Ed25519 (RFC 8410)
+const ED25519_SPKI_PREFIX = Buffer.from('302a300506032b6570032100', 'hex');
+
+export async function ensureAgentSignupTables(pool: Pool): Promise<void> {
+  await pool.query(`
+    CREATE TABLE IF NOT EXISTS agent_signup_challenge (
+      nonce       TEXT PRIMARY KEY,
+      pubkey_hex  TEXT NOT NULL,
+      ip_hash     TEXT NOT NULL,
+      expires_at  TIMESTAMPTZ NOT NULL,
+      used_at     TIMESTAMPTZ
+    );
+    CREATE TABLE IF NOT EXISTS agent_credentials (
+      id             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+      pubkey_hex     TEXT NOT NULL UNIQUE,
+      agent_name     TEXT NOT NULL,
+      tier           TEXT NOT NULL DEFAULT 'sandbox',
+      token_hash     TEXT NOT NULL UNIQUE,
+      token_prefix   TEXT NOT NULL,
+      owner_email    TEXT,
+      claimed_at     TIMESTAMPTZ,
+      max_records    INTEGER NOT NULL DEFAULT 500,
+      max_bytes      INTEGER NOT NULL DEFAULT 2097152,
+      expires_at     TIMESTAMPTZ NOT NULL,
+      created_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
+    );
+    CREATE TABLE IF NOT EXISTS agent_claim_tokens (
+      claim_code     TEXT PRIMARY KEY,
+      agent_id       UUID NOT NULL REFERENCES agent_credentials(id) ON DELETE CASCADE,
+      pin_hash       TEXT NOT NULL,
+      expires_at     TIMESTAMPTZ NOT NULL,
+      claimed_by     TEXT,
+      claimed_at     TIMESTAMPTZ
+    );
+  `);
+}
+
+export function sha256Hex(value: string): string {
+  return crypto.createHash('sha256').update(value, 'utf8').digest('hex');
+}
+
+export function verifyEd25519Challenge(pubkeyHex: string, nonce: string, sigHex: string): boolean {
+  const pubRaw = Buffer.from(pubkeyHex.trim(), 'hex');
+  const sigRaw = Buffer.from(sigHex.trim(), 'hex');
+  if (pubRaw.length !== 32 || sigRaw.length !== 64) return false;
+  const derKey = Buffer.concat([ED25519_SPKI_PREFIX, pubRaw]);
+  const keyObj = crypto.createPublicKey({ key: derKey, format: 'der', type: 'spki' });
+  const message = Buffer.from(`padam-agent-signup-v1|${nonce}|${pubkeyHex.trim().toLowerCase()}`, 'utf8');
+  return crypto.verify(null, message, keyObj, sigRaw);
+}
