@@ -0,0 +1,82 @@
+import crypto from 'node:crypto';
+import { NextRequest, NextResponse } from 'next/server';
+import { dbRateLimit, clientIp } from '@/lib/rate-limit-db';
+import {
+  SANDBOX_LIMITS,
+  ensureAgentSignupTables,
+  sha256Hex,
+  verifyEd25519Challenge,
+} from '@/lib/agent-signup';
+
+export const dynamic = 'force-dynamic';
+
+export async function POST(req: NextRequest) {
+  const ip = clientIp(req as never);
+  // Р–С‘СЃС‚РєРёР№ Р»РёРјРёС‚: РЅРµ Р±РѕР»РµРµ 3 СЂРµРіРёСЃС‚СЂР°С†РёР№ РЅРѕРІС‹С… Р°РіРµРЅС‚РѕРІ СЃ РѕРґРЅРѕРіРѕ IP РІ С‡Р°СЃ
+  if (ip !== 'unknown' && !(await dbRateLimit(`agent_reg:${ip}`, 3, 3_600_000))) {
+    return NextResponse.json({ error: 'signup_rate_limit_exceeded' }, { status: 429 });
+  }
+  const body = await req.json().catch(() => ({}));
+  const pubkeyHex = String(body?.pubkey_hex || '').trim().toLowerCase();
+  const nonce = String(body?.nonce || '').trim();
+  const signatureHex = String(body?.signature_hex || '').trim().toLowerCase();
+  const agentName = String(body?.agent_name || 'padam-agent').trim().slice(0, 64) || 'padam-agent';
+
+  if (!/^[0-9a-f]{64}$/.test(pubkeyHex) || !/^[0-9a-f]{48}$/.test(nonce) || !/^[0-9a-f]{128}$/.test(signatureHex)) {
+    return NextResponse.json({ error: 'invalid_payload' }, { status: 400 });
+  }
+  const url = process.env.SUBMISSIONS_DB_URL;
+  if (!url) return NextResponse.json({ error: 'no_db' }, { status: 500 });
+
+  const { Pool } = await import('@neondatabase/serverless');
+  const pool = new Pool({ connectionString: url });
+  await ensureAgentSignupTables(pool);
+
+  const ch = await pool.query(
+    `UPDATE agent_signup_challenge
+        SET used_at = NOW()
+      WHERE nonce = $1 AND pubkey_hex = $2 AND used_at IS NULL AND expires_at > NOW()
+      RETURNING nonce`,
+    [nonce, pubkeyHex],
+  );
+  if (!ch.rowCount) {
+    return NextResponse.json({ error: 'challenge_missing_or_expired' }, { status: 401 });
+  }
+  if (!verifyEd25519Challenge(pubkeyHex, nonce, signatureHex)) {
+    return NextResponse.json({ error: 'invalid_ed25519_signature' }, { status: 401 });
+  }
+
+  const rawToken = `padam_sbx_${crypto.randomBytes(24).toString('hex')}`;
+  const tokenHash = sha256Hex(rawToken);
+  const expiresAt = new Date(Date.now() + SANDBOX_LIMITS.ttlDays * 86_400_000).toISOString();
+  const cred = await pool.query(
+    `INSERT INTO agent_credentials (pubkey_hex, agent_name, tier, token_hash, token_prefix, max_records, max_bytes, expires_at)
+     VALUES ($1, $2, 'sandbox', $3, $4, $5, $6, $7)
+     ON CONFLICT (pubkey_hex) DO UPDATE SET
+       agent_name = EXCLUDED.agent_name,
+       token_hash = EXCLUDED.token_hash,
+       token_prefix = EXCLUDED.token_prefix,
+       expires_at = EXCLUDED.expires_at
+     RETURNING id`,
+    [pubkeyHex, agentName, tokenHash, rawToken.slice(0, 14), SANDBOX_LIMITS.maxRecords, SANDBOX_LIMITS.maxBytes, expiresAt],
+  );
+  const agentId = cred.rows[0].id;
+  const claimCode = crypto.randomBytes(9).toString('hex');
+  const claimPin = String(crypto.randomInt(100000, 999999));
+  const claimExp = new Date(Date.now() + 7 * 86_400_000).toISOString();
+  await pool.query(
+    `INSERT INTO agent_claim_tokens (claim_code, agent_id, pin_hash, expires_at)
+     VALUES ($1, $2, $3, $4)`,
+    [claimCode, agentId, sha256Hex(claimPin), claimExp],
+  );
+
+  return NextResponse.json({
+    ok: true,
+    agent_id: agentId,
+    token: rawToken,
+    claim_code: claimCode,
+    claim_pin: claimPin,
+    claim_url: `/claim-agent?code=${claimCode}`,
+    limits: SANDBOX_LIMITS,
+  });
+}
